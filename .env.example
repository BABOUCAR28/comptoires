# Copier en .env en local (jamais commité). En ligne : saisir ces variables dans le tableau de bord de l'hébergeur.
NODE_ENV=production
PORT=3000
SITE_URL=https://votre-domaine.sn

# Supabase : Project Settings > API (URL) et API Keys (clé SECRÈTE « service_role » / « secret »).
# ⚠ Cette clé donne tous les droits : serveur uniquement, jamais dans le navigateur ni sur GitHub.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Texte aléatoire long (32+ caractères) pour signer les connexions admin.
SESSION_SECRET=

# Compte admin créé au 1er démarrage SI la base n'en contient pas (inutile après migration).
ADMIN_USER=admin
ADMIN_PASSWORD=

# 1 si le site est derrière le proxy HTTPS de l'hébergeur (Render, Railway…)
TRUST_PROXY=1
# Optionnel : notification à chaque demande (POST texte), ex. un sujet ntfy.sh privé
NOTIFY_URL=
